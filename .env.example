# ----------------------------------------------------------------------------
# Batch + Live Global Geopolitical Lakehouse — Environment Configuration
# ----------------------------------------------------------------------------

# Project & Compose
COMPOSE_PROJECT_NAME=gdelt-lakehouse

# MinIO (S3-compatible Lakehouse Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_BUCKET=lakehouse

# PostgreSQL (Metastore, Airflow, Superset Databases)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
METASTORE_DB=metastore
AIRFLOW_DB=airflow
SUPERSET_DB=superset

# MongoDB (Hot Tier — Single Node Replica Set)
MONGO_URI=mongodb://mongodb:27017/?replicaSet=rs0
MONGO_DATABASE=market_data

# Apache Kafka (KRaft Streaming Broker)
KAFKA_BROKER=kafka:9092

# Apache Spark
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_URL=spark://spark-master:7077

# Apache Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Apache Superset
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=gdelt_lakehouse_workshop_secret_key_2026_xyz!

# GDELT Global Event Parameters
BACKFILL_DAYS=2
SLICES_PER_DAY=96
GDELT_POLL_INTERVAL_SEC=60
STAGING_DIR=/tmp/lakehouse/landing/gdelt
